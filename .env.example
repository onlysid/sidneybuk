# The password for /admin. Eight characters or more.
ADMIN_PASSWORD=

# Signs the sign-in cookie and encrypts the API keys you save in the admin area. Any long random text:
#   openssl rand -hex 32
# Keep it the same for the life of the database: change it and the saved API keys can no longer be read.
APP_SECRET=

# The database's own password. Letters and numbers only (it goes inside an address).
POSTGRES_PASSWORD=

POSTGRES_USER=sidneyb
POSTGRES_DB=sidneyb

# The port the site is served on, and the port the database is offered on to this machine only.
PORT=3000
DB_PORT=5433

# Where the site finds the database when it runs outside Docker (npm run dev). Docker Compose sets its own.
DATABASE_URL=postgres://sidneyb:CHANGE_ME@localhost:5433/sidneyb

# Where uploaded files are kept when the site runs outside Docker.
UPLOAD_DIR=./data/uploads

# The site's public address. Only needed if reverse proxy does not pass on the host and scheme
# (it is used for the address Strava calls back to).
# SITE_URL=https://sidneyb.uk

# While developing: extra addresses the site may be opened from (comma separated), such as a tunnel's host name.
# This machine's own names and network addresses are allowed already.
# DEV_ORIGINS=my-tunnel.example.com

# Set to 1 only if the site is served over https by a proxy that does not say so, and sign-in will not stick.
# INSECURE_COOKIES=1